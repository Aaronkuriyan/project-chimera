# Optional: enables LLM-powered bizarro-content generation via Groq's
# OpenAI-compatible API (fast + free tier, good for live demos).
# If unset, Chimera falls back to deterministic fabrication (no API needed).
GROQ_API_KEY=

# Optional: persists bot-hit telemetry for /dashboard across restarts and
# server instances via Upstash Redis's REST API (edge-compatible).
# Free tier at https://upstash.com. If unset, Chimera falls back to an
# in-memory store that resets on restart — fine for local dev/demos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
